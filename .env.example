# Copy this file to .env and fill it in. Never commit .env.

# OpenAI: powers the CV, interview and career tools
OPENAI_API_KEY=

# Stripe: Premium subscriptions (use test keys while developing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase: accounts and saved data.
# The publishable key is sent to the browser. The service role key is server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the site is served from. Used for Stripe redirects and CORS.
CLIENT_URL=http://localhost:3000

PORT=3000
